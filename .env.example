# Copier ce fichier en .env et remplir les valeurs

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Email du compte partagé créé dans Supabase → Authentication → Users
# (le mot de passe, lui, reste uniquement dans Supabase)
VITE_LOGIN_EMAIL=cinecito@cinecito.app

# TMDB → https://www.themoviedb.org/settings/api → "API Read Access Token"
VITE_TMDB_TOKEN=eyJhbGciOi...
